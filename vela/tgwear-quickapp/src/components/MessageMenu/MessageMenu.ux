<!--
  消息操作菜单

  设计说明：
    - 手环屏幕窄长（212×520 设计宽），因此菜单以「底部弹出卡片」的形式呈现，
      不占用消息列表区域。
    - 只暴露手机端确实实现了能力的操作项；不可用项由父页面通过 canXxx 属性控制。
    - 不使用任何图片资源，纯文本 + 背景色，降低手环端渲染与内存压力。
-->
<template>
  <div class="menu-mask" if="{{!hide}}" @click="onMaskTap">
    <div class="menu-card" @click="noop">
      <text class="menu-title">{{title}}</text>
      <text class="menu-item" if="{{canReply}}" @click="emit('reply')">回复该消息</text>
      <text class="menu-item" if="{{canEdit}}" @click="emit('edit')">编辑</text>
      <text class="menu-item" if="{{canForward}}" @click="emit('forward')">转发到最近会话</text>
      <text class="menu-item" if="{{canPin}}" @click="emit('pin')">置顶此消息</text>
      <text class="menu-item menu-danger" if="{{canDelete}}" @click="emit('delete')">删除消息</text>
      <text class="menu-item menu-cancel" @click="emit('cancel')">取消</text>
    </div>
  </div>
</template>

<style>
.menu-mask {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 212px;
  height: 520px;
  background-color: rgba(0, 0, 0, 0.72);
  align-items: center;
  justify-content: center;
}
.menu-card {
  width: 176px;
  padding: 10px 0px;
  background-color: #1f1f1f;
  border-radius: 18px;
  flex-direction: column;
  align-items: center;
}
.menu-title {
  font-size: 15px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.75);
  margin-bottom: 6px;
}
.menu-item {
  width: 100%;
  height: 40px;
  text-align: center;
  font-size: 17px;
  color: #ffffff;
}
.menu-danger {
  color: #ff6b6b;
}
.menu-cancel {
  color: rgba(255, 255, 255, 0.6);
  border-top-color: rgba(255, 255, 255, 0.1);
  border-top-width: 1px;
}
</style>

<script>
export default {
  props: {
    // 是否隐藏整个菜单
    hide: { default: true },
    // 菜单标题（例如被操作消息的摘要，便于确认操作对象）
    title: { default: '消息操作' },
    canReply: { default: false },
    canEdit: { default: false },
    canForward: { default: false },
    canPin: { default: false },
    canDelete: { default: true },
  },
  emit(name) {
    this.$emit(name, {})
  },
  onMaskTap() {
    this.$emit('cancel', {})
  },
  noop() {},
}
</script>
